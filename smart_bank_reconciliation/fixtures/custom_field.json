  "read_only": 1,
  "module": "Smart Bank Reconciliation",
  "name": "Bank Transaction-recon_queue"
 },
 {
  "doctype": "Custom Field",
  "dt": "Bank Transaction",
  "fieldname": "recon_confidence",
  "label": "Confidence %",
